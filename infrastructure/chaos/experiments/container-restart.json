{
  "apiVersion": "chaos-mesh.org/v1alpha1",
  "kind": "PodChaos",
  "metadata": {
    "name": "container-restart",
    "namespace": "banking-chaos",
    "labels": {
      "chaos.banking.io/managed": "true"
    }
  },
  "spec": {
    "mode": "one",
    "selector": {
      "namespaces": [
        "banking-chaos"
      ],
      "labelSelectors": {
        "app": "banking-api",
        "chaos.banking.io/eligible": "true",
        "chaos.banking.io/data": "synthetic"
      },
      "pods": {
        "banking-chaos": [
          "RUNNER_SELECTS_ONE_POD"
        ]
      }
    },
    "action": "container-kill",
    "containerNames": [
      "app"
    ]
  }
}
