{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "type": "datasource", "pluginId": "loki" },
    { "name": "DS_TEMPO",      "label": "Tempo",      "type": "datasource", "pluginId": "tempo" }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "version": "1.0.0" },
    { "type": "datasource", "id": "tempo",      "version": "1.0.0" }
  ],
  "title": "Banking — Service Dashboard",
  "uid": "banking-service-dashboard",
  "description": "Per-service: RPS · Error Rate · p50/p95/p99 Latency · CPU · Memory · MongoDB · Redis · Live Logs · Trace Search",
  "tags": ["banking", "service"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(banking_http_requests_total, service)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "label": "Service"
      },
      {
        "name": "interval",
        "type": "interval",
        "options": [
          { "selected": false, "text": "30s", "value": "30s" },
          { "selected": true,  "text": "1m",  "value": "1m"  },
          { "selected": false, "text": "5m",  "value": "5m"  },
          { "selected": false, "text": "15m", "value": "15m" }
        ],
        "label": "Interval"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request Rate (RPS)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "palette-classic" } }
      },
      "targets": [{
        "expr": "sum by (route, method) (rate(banking_http_requests_total{service=\"$service\"}[$interval]))",
        "legendFormat": "{{method}} {{route}}"
      }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Error Rate (%)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.001 },
            { "color": "red", "value": 0.01 }
          ]},
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "targets": [{
        "expr": "sum(rate(banking_http_requests_total{service=\"$service\", status_code=~\"5..\"}[$interval])) / sum(rate(banking_http_requests_total{service=\"$service\"}[$interval]))",
        "legendFormat": "5xx Error Rate"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latency — p50 / p95 / p99",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(banking_http_request_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(banking_http_request_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(banking_http_request_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "RPS (now)",
      "gridPos": { "x": 0, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "sum(rate(banking_http_requests_total{service=\"$service\"}[1m]))", "legendFormat": "RPS" }]
    },
    {
      "id": 5, "type": "stat", "title": "Active Requests",
      "gridPos": { "x": 4, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":50},{"color":"red","value":200}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "sum(banking_http_active_requests{service=\"$service\"})", "legendFormat": "Active" }]
    },
    {
      "id": 6, "type": "stat", "title": "p99 Latency",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":0.5},{"color":"red","value":2}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(banking_http_request_duration_seconds_bucket{service=\"$service\"}[5m])))", "legendFormat": "p99" }]
    },
    {
      "id": 7, "type": "stat", "title": "Error Rate",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":0.001},{"color":"red","value":0.01}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "sum(rate(banking_http_requests_total{service=\"$service\",status_code=~\"5..\"}[5m])) / sum(rate(banking_http_requests_total{service=\"$service\"}[5m]))", "legendFormat": "Error %" }]
    },
    {
      "id": 16, "type": "stat", "title": "DB Query p95",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":0.1},{"color":"red","value":0.5}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(banking_db_query_duration_seconds_bucket{service=\"$service\"}[5m])))", "legendFormat": "DB p95" }]
    },
    {
      "id": 17, "type": "stat", "title": "Cache Hit Ratio",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"red","value":null},{"color":"yellow","value":0.7},{"color":"green","value":0.9}] } } },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "banking_cache_hit_ratio{service=\"$service\"}", "legendFormat": "Hit Ratio" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "CPU Usage",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [{ "expr": "rate(process_cpu_seconds_total{job=\"banking\", service=\"$service\"}[$interval])", "legendFormat": "CPU" }]
    },
    {
      "id": 9, "type": "timeseries", "title": "Memory (RSS / Heap)",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"banking\", service=\"$service\"}", "legendFormat": "RSS" },
        { "expr": "process_heap_bytes{job=\"banking\", service=\"$service\"}", "legendFormat": "Heap" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "gRPC Duration — p95",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (method, le) (rate(banking_grpc_request_duration_seconds_bucket{service=\"$service\"}[$interval])))",
        "legendFormat": "p95 {{method}}"
      }]
    },
    {
      "id": 13, "type": "timeseries", "title": "MongoDB Query Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (operation, le) (rate(banking_db_query_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p50 {{operation}}" },
        { "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(banking_db_query_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p95 {{operation}}" },
        { "expr": "histogram_quantile(0.99, sum by (operation, le) (rate(banking_db_query_duration_seconds_bucket{service=\"$service\"}[$interval])))", "legendFormat": "p99 {{operation}}" }
      ]
    },
    {
      "id": 14, "type": "timeseries", "title": "Redis Cache Operations",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "hit" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "miss" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum by (status) (rate(banking_cache_operations_total{service=\"$service\"}[$interval]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 11, "type": "logs", "title": "Live Logs",
      "gridPos": { "x": 0, "y": 28, "w": 16, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "expr": "{service=\"$service\"} | json | line_format \"{{.level | upper}} {{.message}}\"",
        "legendFormat": ""
      }]
    },
    {
      "id": 12, "type": "timeseries", "title": "HTTP Status Distribution",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(banking_http_requests_total{service=\"$service\", status_code=~\"2..\"}[$interval]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(banking_http_requests_total{service=\"$service\", status_code=~\"4..\"}[$interval]))", "legendFormat": "4xx" },
        { "expr": "sum(rate(banking_http_requests_total{service=\"$service\", status_code=~\"5..\"}[$interval]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 15, "type": "traces", "title": "Recent Traces",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "targets": [{
        "queryType": "traceql",
        "query": "{ resource.service.name = \"$service\" } | select(span.http.method, span.http.status_code, span.http.route) | limit 20",
        "tableType": "traces"
      }]
    }
  ]
}
