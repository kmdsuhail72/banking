{
  "uid": "banking-incidents",
  "title": "Banking Incident Management",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Incident Command (local)",
      "url": "http://localhost:4020",
      "targetBlank": true
    },
    {
      "title": "SLO budgets",
      "url": "/d/banking-slo",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Active incidents",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(banking_incidents{status!~\"RESOLVED|CLOSED\"})",
          "legendFormat": "{{severity}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Incidents by severity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (banking_incidents)",
          "legendFormat": "{{severity}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Incident lifecycle",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (banking_incidents)",
          "legendFormat": "{{severity}} {{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Alert webhook deliveries / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(banking_incident_webhook_total[5m]))",
          "legendFormat": "{{severity}} {{status}}"
        }
      ]
    }
  ]
}
