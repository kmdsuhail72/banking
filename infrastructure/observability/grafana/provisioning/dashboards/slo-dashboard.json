{
  "uid": "banking-slo",
  "title": "Banking SLOs and error budgets",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "banking",
    "slo"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "availability technical success (30d)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - banking:slo_error_ratio:30d{slo=\"availability\"}",
          "legendFormat": "{{service}} {{slo}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
